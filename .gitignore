# ---------------------------------------------------------------------------
# 私密数据 —— 绝对不能进仓库
# ---------------------------------------------------------------------------
# 账号库：里面有每个账号的 Bearer token（相当于登录凭据）
config.json
dist/config.json
src/config.json
# 设备信任档案：浏览器 profile，里面存着 CAS 的登录会话 cookie
.profiles/
dist/.profiles/
src/.profiles/
# 反冲突随机盐
.anti_collision_salt
# 运行日志
*.log

# ---------------------------------------------------------------------------
# 构建产物 —— 体积太大，不进仓库
# ---------------------------------------------------------------------------
dist/
build/
build_tmp/
release/
release_zip/
release_zip*/
# 内置 Chromium（约 430MB，用 README 里的命令现下）
bundled_chromium/
*.exe
*.spec
# 分发包 zip（265MB，GitHub 单文件上限 100MB，放 Release 里）
*.zip

# 本机排障用的临时脚本与日志
过程文件/
test_*.py
_inline.js

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.bak
